# ==========================================
# Maintenance Copilot Backend Environment Example
# ==========================================

# Application Runtime
APP_ENV=development
APP_ORIGIN=http://localhost:8000
PORT=8000
DB_PORT=55432
SESSION_SIGNING_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES

# ------------------------------------------
# Database Configuration (Option A: Local Docker PostgreSQL)
# ------------------------------------------
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD
DATABASE_URL=postgresql://maintenance:REPLACE_WITH_RANDOM_LOCAL_PASSWORD@localhost:55432/maintenance
DATABASE_SCHEMA=public
VECTOR_SCHEMA=public

# ------------------------------------------
# Database Configuration (Option B: Managed PostgreSQL / Supabase)
# ------------------------------------------
# When using Supabase or managed PostgreSQL:
# 1. Use the Session pooler (port 5432) or direct URI to support asyncpg prepared statements,
#    or set STATEMENT_CACHE_SIZE=0 when connecting via transaction pooler (port 6543 / PgBouncer).
# 2. Set DATABASE_SCHEMA=maintenance and VECTOR_SCHEMA=extensions.
# 3. Mount and configure the TLS root CA certificate for verify-full mode.
# Example:
# DATABASE_URL=postgresql://maintenance_backend.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=data/certs/supabase-root-2021.crt
# DATABASE_SCHEMA=maintenance
# VECTOR_SCHEMA=extensions
# DATABASE_SSL_ROOT_CERT=data/certs/supabase-root-2021.crt
# STATEMENT_CACHE_SIZE=0

# ------------------------------------------
# LLM Provider Configuration
# ------------------------------------------
# Provider selection: 'auto', 'deepseek', or 'gemini'
LLM_PROVIDER=deepseek

# DeepSeek Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Google Gemini Configuration (OpenAI-compatible endpoint)
# Endpoint: https://generativelanguage.googleapis.com/v1beta/openai/
# Model allowlist: gemini-3.8-flash, gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------
# Embedding & Reranker Configuration
# ------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_REVISION=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a
MODEL_CACHE_DIR=models
ARTIFACT_DIR=artifacts
RERANK_ENABLED=false
LANGFUSE_ENABLED=false
