      "properties": {
        "possible_explanations": {
          "items": {
            "type": "string"
          },
          "title": "Possible Explanations",
          "type": "array"
        },
        "basis": {
          "items": {
            "type": "string"
          },
          "title": "Basis",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "information_needed": {
          "items": {
            "type": "string"
          },
          "title": "Information Needed",
          "type": "array"
        },
        "what_would_weaken_this": {
          "items": {
            "type": "string"
          },
          "title": "What Would Weaken This",
          "type": "array"
        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        },
        "historical_claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Historical Claims",
