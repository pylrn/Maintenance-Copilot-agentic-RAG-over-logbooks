            "$ref": "#/$defs/RecordSnapshot"
          },
          "title": "Records",
          "type": "array"
        }
      },
      "required": [
        "manifest",
        "records"
      ],
      "title": "ParsedCorpus",
      "type": "object"
    },
    "PublicEvent": {
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": "maintenance/v1",
          "default": "maintenance/v1",
          "title": "Protocol Version",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "type": {
          "enum": [
            "run_started",
            "query_interpreted",
            "search_started",
            "search_completed",
            "tool_started",
            "tool_completed",
            "evidence_ready",
            "validation_started",
            "board_updated",
            "answer_validated",
            "run_cancelled",
            "run_failed",
            "done"
          ],
          "title": "Type",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "run_id",
        "sequence",
        "type",
        "data"
      ],
      "title": "PublicEvent",
      "type": "object"
    },
    "ReceiptSupport": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "aggregate_receipt",
            "search_comparison"
          ],
          "title": "Kind",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "result_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Result Keys",
          "type": "array"
        }
      },
