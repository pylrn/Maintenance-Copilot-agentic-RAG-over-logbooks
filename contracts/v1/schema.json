{
  "$defs": {
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "challenge",
            "distinguish",
            "sensitivity",
            "hypothesis",
            "handover"
          ],
          "title": "Action",
          "type": "string"
        },
        "parent_answer_id": {
          "format": "uuid",
          "title": "Parent Answer Id",
          "type": "string"
        },
        "expected_revision": {
          "minimum": 0,
          "title": "Expected Revision",
          "type": "integer"
        },
        "idempotency_key": {
          "format": "uuid",
          "title": "Idempotency Key",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "action",
        "parent_answer_id",
        "expected_revision",
        "idempotency_key"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "AllowedAction": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "challenge",
            "distinguish",
            "sensitivity",
            "hypothesis",
            "handover"
          ],
          "title": "Action",
          "type": "string"
        },
        "parent_answer_id": {
          "format": "uuid",
          "title": "Parent Answer Id",
          "type": "string"
        },
        "state_revision": {
          "minimum": 0,
          "title": "State Revision",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "parent_answer_id",
        "state_revision"
      ],
      "title": "AllowedAction",
      "type": "object"
    },
    "AnswerEnvelope": {
      "additionalProperties": false,
      "properties": {
        "answer_id": {
          "format": "uuid",
          "title": "Answer Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "mode": {
          "enum": [
            "EVIDENCE",
            "HYPOTHESIS",
            "CHALLENGE",
            "SENSITIVITY",
            "DISTINGUISH",
            "HANDOVER"
          ],
          "title": "Mode",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported_historical",
            "partial_evidence",
            "clarification_needed",
            "insufficient_evidence",
            "retrieval_unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "missing": {
          "items": {
            "type": "string"
          },
          "title": "Missing",
          "type": "array"
        },
        "clarification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification"
        },
        "visual_refs": {
          "items": {
            "type": "string"
          },
          "title": "Visual Refs",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "$ref": "#/$defs/AllowedAction"
          },
          "title": "Allowed Actions",
          "type": "array"
        }
      },
      "required": [
        "answer_id",
        "run_id",
        "mode",
        "status",
        "headline",
        "claims"
      ],
      "title": "AnswerEnvelope",
      "type": "object"
    },
    "BoardItem": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "format": "uuid",
          "title": "Item Id",
          "type": "string"
        },
        "column": {
          "enum": [
            "known",
            "reported",
            "missing"
          ],
          "title": "Column",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "origin": {
          "enum": [
            "user_report",
            "historical_log",
            "verified_document",
            "schema_gap"
          ],
          "title": "Origin",
          "type": "string"
        },
        "origin_ref": {
          "title": "Origin Ref",
          "type": "string"
        },
        "created_revision": {
          "minimum": 0,
          "title": "Created Revision",
          "type": "integer"
        },
        "supersedes": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "verification_status": {
          "enum": [
            "user_reported",
            "source_validated",
            "unresolved"
          ],
          "title": "Verification Status",
          "type": "string"
        },
        "affected_component_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Component Ids",
          "type": "array"
        }
      },
      "required": [
        "item_id",
        "column",
        "text",
        "origin",
        "origin_ref",
        "created_revision",
        "verification_status"
      ],
      "title": "BoardItem",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "claim_type": {
          "enum": [
            "historical_problem",
            "historical_action",
            "reported_result",
            "source_difference",
            "count",
            "sensitivity"
          ],
          "title": "Claim Type",
          "type": "string"
        },
        "supports": {
          "items": {
            "discriminator": {
              "mapping": {
                "aggregate_receipt": "#/$defs/ReceiptSupport",
                "log_span": "#/$defs/SupportSpan",
                "search_comparison": "#/$defs/ReceiptSupport"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/SupportSpan"
              },
              {
                "$ref": "#/$defs/ReceiptSupport"
              }
            ]
          },
          "minItems": 1,
          "title": "Supports",
          "type": "array"
        }
      },
      "required": [
        "claim_id",
        "text",
        "claim_type",
        "supports"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "tier": {
          "enum": [
            "direct",
            "related",
            "tangential"
          ],
          "title": "Tier",
          "type": "string"
        },
        "facts": {
          "additionalProperties": {
            "enum": [
              "agreement",
              "difference",
              "unknown"
            ],
            "type": "string"
          },
          "title": "Facts",
          "type": "object"
        },
        "query_mentions": {
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "title": "Query Mentions",
          "type": "array"
        },
        "source_mentions": {
          "items": {
            "$ref": "#/$defs/Mention"
          },
          "title": "Source Mentions",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "tier",
        "facts"
      ],
      "title": "Compatibility",
      "type": "object"
    },
    "ComponentContextEnvelope": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "title": "Component Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "citations": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Citations",
          "type": "array"
        },
        "profile_revision": {
          "title": "Profile Revision",
          "type": "integer"
        },
        "applicability": {
          "enum": [
            "generic",
            "applicable",
            "unknown",
            "mismatch"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "source_available": {
          "title": "Source Available",
          "type": "boolean"
        },
        "asset_mapping_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Mapping Ids",
          "type": "array"
        },
        "related_log_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Log Ids",
          "type": "array"
        }
      },
      "required": [
        "component_id",
        "name",
        "explanation",
        "citations",
        "profile_revision",
        "applicability",
        "source_available",
        "asset_mapping_ids",
        "related_log_ids"
      ],
      "title": "ComponentContextEnvelope",
      "type": "object"
    },
    "ComputationReceipt": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "aggregate",
            "comparison",
            "search_comparison"
          ],
          "title": "Kind",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "result": {
          "additionalProperties": true,
          "title": "Result",
          "type": "object"
        },
        "corpus_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "title": "Corpus Ids",
          "type": "array"
        },
        "manifest_sha256": {
          "title": "Manifest Sha256",
          "type": "string"
        },
        "contributing_ids": {
          "items": {
            "type": "string"
          },
          "title": "Contributing Ids",
          "type": "array"
        },
        "validator_version": {
          "default": "computation/v1",
          "title": "Validator Version",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "parameters",
        "result",
        "corpus_ids",
        "manifest_sha256",
        "contributing_ids"
      ],
      "title": "ComputationReceipt",
      "type": "object"
    },
    "CorpusManifest": {
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "format": "uuid",
          "title": "Corpus Id",
          "type": "string"
        },
        "domain": {
          "enum": [
            "aviation",
            "facility"
          ],
          "title": "Domain",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "terms_note": {
          "title": "Terms Note",
          "type": "string"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "distinct_pairs": {
          "minimum": 0,
          "title": "Distinct Pairs",
          "type": "integer"
        },
        "fields": {
          "items": {
            "type": "string"
          },
          "title": "Fields",
          "type": "array"
        },
        "parser_version": {
          "default": "csv/v1",
          "title": "Parser Version",
          "type": "string"
        },
        "normalization_version": {
          "default": "reviewed/v1",
          "title": "Normalization Version",
          "type": "string"
        },
        "catalog_revision": {
          "default": "unreviewed/no-visual-mapping",
          "title": "Catalog Revision",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "corpus_id",
        "domain",
        "sha256",
        "source_url",
        "terms_note",
        "record_count",
        "distinct_pairs",
        "fields"
      ],
      "title": "CorpusManifest",
      "type": "object"
    },
    "DraftAnswer": {
      "additionalProperties": false,
      "properties": {
        "proposed_status": {
          "enum": [
            "supported_historical",
            "partial_evidence",
            "clarification_needed",
            "insufficient_evidence",
            "retrieval_unavailable"
          ],
          "title": "Proposed Status",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Findings",
          "type": "array"
        },
        "historical_actions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Historical Actions",
          "type": "array"
        },
        "contrasting_cases": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Contrasting Cases",
          "type": "array"
        },
        "gap_refs": {
          "items": {
            "type": "string"
          },
          "title": "Gap Refs",
          "type": "array"
        },
        "limitation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Limitation Refs",
          "type": "array"
        },
        "clarification_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clarification Ref"
        },
        "component_refs": {
          "items": {
            "type": "string"
          },
          "title": "Component Refs",
          "type": "array"
        }
      },
      "required": [
        "proposed_status"
      ],
      "title": "DraftAnswer",
      "type": "object"
    },
    "ErrorEnvelope": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "title": "Error",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "error",
        "message"
      ],
      "title": "ErrorEnvelope",
      "type": "object"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "corpus_id": {
          "format": "uuid",
          "title": "Corpus Id",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "field": {
          "enum": [
            "PROBLEM",
            "ACTION",
            "DESCRIPTION"
          ],
          "title": "Field",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "quote": {
          "title": "Quote",
          "type": "string"
        },
        "source_sha256": {
          "description": "SHA256 of decoded raw field encoded as UTF-8",
          "title": "Source Sha256",
          "type": "string"
        }
      },
      "required": [
        "corpus_id",
        "record_id",
        "field",
        "start",
        "end",
        "quote",
        "source_sha256"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
