        },
        "limits": {
          "items": {
            "type": "string"
          },
          "title": "Limits",
          "type": "array"
        },
        "historical_claims": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Historical Claims",
          "type": "array"
        }
      },
      "required": [
        "possible_explanations",
        "basis",
        "assumptions",
        "information_needed",
        "what_would_weaken_this",
        "limits"
      ],
      "title": "HypothesisDraft",
      "type": "object"
    },
    "HypothesisEnvelope": {
