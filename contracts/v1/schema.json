        },
        "answer_id": {
          "format": "uuid",
          "title": "Answer Id",
          "type": "string"
        },
        "run_id": {
          "format": "uuid",
          "title": "Run Id",
          "type": "string"
        },
        "parent_answer_id": {
          "format": "uuid",
          "title": "Parent Answer Id",
          "type": "string"
        },
        "state_revision": {
          "title": "State Revision",
          "type": "integer"
        },
        "mode": {
          "const": "HYPOTHESIS",
